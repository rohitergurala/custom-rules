# E-Commerce & Shopping Detection Rules for Suricata
# Purpose: Detect and block DNS queries AND HTTP access to shopping sites
# Created: December 2024

# ============================================================================
# AMAZON - DNS + HTTP DETECTION
# ============================================================================
drop dns any any -> any any (msg:"Shopping - Amazon DNS Query"; dns_query; content:"amazon.com"; classtype:policy-violation; sid:5116000; rev:1;)
drop tls any any -> any any (msg:"Shopping - Amazon TLS SNI"; flow:established,to_server; tls.sni; content:"amazon.com"; fast_pattern; classtype:policy-violation; sid:5116001; rev:1;)
drop dns any any -> any any (msg:"Shopping - Amazon AWS DNS Query"; dns_query; content:"amazonawscom"; classtype:policy-violation; sid:5116002; rev:1;)
drop tls any any -> any any (msg:"Shopping - Amazon AWS TLS SNI"; flow:established,to_server; tls.sni; content:"amazonawscom"; fast_pattern; classtype:policy-violation; sid:5116003; rev:1;)
drop http any any -> any any (msg:"Shopping - Amazon HTTP Access"; http.host; content:"amazon.com"; classtype:policy-violation; sid:5116004; rev:1;)
drop http any any -> any any (msg:"Shopping - Amazon AWS HTTP Access"; http.host; content:"amazonawscom"; classtype:policy-violation; sid:5116005; rev:1;)

