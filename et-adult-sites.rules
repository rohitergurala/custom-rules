# ============================================================================
# SURICATA RULES FOR ADULT WEBSITES DETECTION
# ============================================================================
# 
# These rules detect access to adult websites via:
# - DNS queries (domain name resolution)
# - HTTP requests (URLs)
# - TLS SNI (HTTPS connection handshake)
#
# Usage: Import into Suricata on OPNsense or Linux
# Purpose: Content filtering, parental controls, security monitoring
#
# ============================================================================

# ============================================================================
# PORNHUB
# ============================================================================

drop dns any any -> any 53 (msg:"OPN_Adult - PornHub - DNS request for pornhub.com"; dns_query; content:"pornhub.com"; nocase; classtype:policy-violation; sid:5101500; rev:1;)
drop tls any any -> any any (msg:"OPN_Adult - PornHub - DNS request for pornhub.com"; flow:established,to_server; tls.sni; content:"pornhub.com"; nocase; fast_pattern; classtype:policy-violation; sid:5101501; rev:1;)
drop http any any -> any $HTTP_PORTS (msg:"OPN_Adult - PornHub - HTTP URL (pornhub.com)"; content:"pornhub.com"; http_uri; flow:to_server,established; classtype:policy-violation; sid:5101502; rev:1;)
drop tls any any -> any any (msg:"OPN_Adult - PornHub - TLS SNI (pornhub.com)"; tls_sni; content:"pornhub.com"; flow:to_server,established; classtype:policy-violation; sid:5101503; rev:1;)

drop dns any any -> any 53 (msg:"OPN_Adult - PornHub - DNS request for pornhubpremium.com"; dns_query; content:"pornhubpremium.com"; nocase; classtype:policy-violation; sid:5101504; rev:1;)
drop tls any any -> any any (msg:"OPN_Adult - PornHub - DNS request for pornhubpremium.com"; flow:established,to_server; tls.sni; content:"pornhubpremium.com"; nocase; fast_pattern; classtype:policy-violation; sid:5101505; rev:1;)
drop http any any -> any $HTTP_PORTS (msg:"OPN_Adult - PornHub - HTTP URL (pornhubpremium.com)"; content:"pornhubpremium.com"; http_uri; flow:to_server,established; classtype:policy-violation; sid:5101506; rev:1;)
drop tls any any -> any any (msg:"OPN_Adult - PornHub - TLS SNI (pornhubpremium.com)"; tls_sni; content:"pornhubpremium.com"; flow:to_server,established; classtype:policy-violation; sid:5101507; rev:1;)

