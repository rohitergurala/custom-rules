# ============================================================================
# VIMEO ADULT (Some adult content on general platforms)
# ============================================================================

# NOTE: Vimeo is a general platform with some adult content
# Blocking entire domain may block legitimate content
# Consider blocking specific keywords instead of entire domain

drop dns any any -> any 53 (msg:"OPN_Adult - Adult content keywords DNS"; dns_query; content:"escort"; nocase; content:"adult"; nocase; classtype:policy-violation; sid:5101568; rev:2;)
drop tls any any -> any any (msg:"OPN_Adult - Adult content keywords TLS SNI"; flow:established,to_server; tls.sni; content:"escort"; nocase; content:"adult"; nocase; fast_pattern; classtype:policy-violation; sid:5101569; rev:3;)
