# News & Blogs Detection Rules for Suricata
# Purpose: Detect and block DNS queries AND HTTP access to news and blog sites
# Created: December 2024

# ============================================================================
# BBC - DNS + HTTP DETECTION
# ============================================================================
drop dns any any -> any any (msg:"News - BBC DNS Query"; dns_query; content:"bbc.com"; classtype:policy-violation; sid:5115000; rev:1;)
drop tls any any -> any any (msg:"News - BBC TLS SNI"; flow:established,to_server; tls.sni; content:"bbc.com"; fast_pattern; classtype:policy-violation; sid:5115001; rev:1;)
drop dns any any -> any any (msg:"News - BBC News DNS Query"; dns_query; content:"bbcnews.com"; classtype:policy-violation; sid:5115002; rev:1;)
drop tls any any -> any any (msg:"News - BBC News TLS SNI"; flow:established,to_server; tls.sni; content:"bbcnews.com"; fast_pattern; classtype:policy-violation; sid:5115003; rev:1;)
drop http any any -> any any (msg:"News - BBC HTTP Access"; http.host; content:"bbc.com"; classtype:policy-violation; sid:5115004; rev:1;)
drop http any any -> any any (msg:"News - BBC News HTTP Access"; http.host; content:"bbcnews.com"; classtype:policy-violation; sid:5115005; rev:1;)

