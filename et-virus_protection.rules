drop http any any -> any any (msg:"ET EXPLOIT_KIT Cool Java Exploit Recent Jar (1)"; flow:established,to_client; flowbits:set,et.exploitkitlanding; file.data; content:"PK"; within:2; content:"SunJCE.class"; classtype:exploit-kit; sid:6400032; rev:5; metadata:created_at 2013_02_13, signature_severity Major, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2024_03_14;)

drop http any any -> any any (msg:"ET HUNTING SUSPICIOUS EXE Download from specific file share site (used in recent maldoc campaign)"; flow:established,to_server; http.uri; content:".exe"; http.host; bsize:10; content:"a.pomf.cat"; fast_pattern; http.header_names; to_lowercase; content:!"|0d 0a|referer|0d 0a|"; reference:md5,c321f38862a24dc8a72a251616b3afdf; classtype:trojan-activity; sid:6400033; rev:6; metadata:created_at 2016_06_09, confidence Medium, signature_severity Major, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2024_04_30;)
