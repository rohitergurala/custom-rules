# Streaming & Entertainment Detection Rules for Suricata
# Purpose: Detect and block DNS queries AND HTTP access to streaming services
# Created: December 2024
# Usage: Copy to /usr/local/etc/suricata/rules/streaming.rules

# ============================================================================
# YOUTUBE - DNS + HTTP DETECTION
# ============================================================================
drop dns any any -> any any (msg:"Streaming - YouTube DNS Query"; dns_query; content:"youtube.com"; classtype:policy-violation; sid:5118000; rev:1;)
drop tls any any -> any any (msg:"Streaming - YouTube TLS SNI"; flow:established,to_server; tls.sni; content:"youtube.com"; fast_pattern; classtype:policy-violation; sid:5118001; rev:1;)
drop dns any any -> any any (msg:"Streaming - YouTube Short URL DNS Query"; dns_query; content:"youtu.be"; classtype:policy-violation; sid:5118002; rev:1;)
drop tls any any -> any any (msg:"Streaming - YouTube Short URL TLS SNI"; flow:established,to_server; tls.sni; content:"youtu.be"; fast_pattern; classtype:policy-violation; sid:5118003; rev:1;)
drop dns any any -> any any (msg:"Streaming - Google Video CDN DNS Query"; dns_query; content:"googlevideo.com"; classtype:policy-violation; sid:5118004; rev:1;)
drop tls any any -> any any (msg:"Streaming - Google Video CDN TLS SNI"; flow:established,to_server; tls.sni; content:"googlevideo.com"; fast_pattern; classtype:policy-violation; sid:5118005; rev:1;)
drop http any any -> any any (msg:"Streaming - YouTube HTTP Access"; http.host; content:"youtube.com"; classtype:policy-violation; sid:5118006; rev:1;)
drop http any any -> any any (msg:"Streaming - YouTube Short URL HTTP Access"; http.host; content:"youtu.be"; classtype:policy-violation; sid:5118007; rev:1;)
drop http any any -> any any (msg:"Streaming - Google Video CDN HTTP Access"; http.host; content:"googlevideo.com"; classtype:policy-violation; sid:5118008; rev:1;)

