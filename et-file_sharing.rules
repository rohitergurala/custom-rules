# ============================================================================
# GENERIC TORRENT/FILE SHARING INDICATORS
# ============================================================================

# Generic "torrent" keyword in DNS
drop dns any any -> any any (msg:"FileShare - Generic Torrent DNS Query"; dns_query; content:"torrent"; nocase; classtype:policy-violation; sid:5111097; rev:1;)
drop tls any any -> any any (msg:"FileShare - Generic Torrent TLS SNI"; flow:established,to_server; tls.sni; content:"torrent"; nocase; fast_pattern; classtype:policy-violation; sid:5111098; rev:1;)

# Generic "download" in suspicious domains
drop dns any any -> any any (msg:"FileShare - Generic Download Site DNS Query"; dns_query; content:"download"; nocase; pcre:"/download.*\.(to|cc|io|me|ws)/i"; classtype:policy-violation; sid:5111099; rev:1;)
drop tls any any -> any any (msg:"FileShare - Generic Download Site TLS SNI"; flow:established,to_server; tls.sni; content:"download"; nocase; fast_pattern; classtype:policy-violation; sid:5111100; rev:1;)

# Generic "pirate" keyword
drop dns any any -> any any (msg:"FileShare - Piracy Site DNS Query"; dns_query; content:"pirate"; nocase; classtype:policy-violation; sid:5111101; rev:1;)
drop tls any any -> any any (msg:"FileShare - Piracy Site TLS SNI"; flow:established,to_server; tls.sni; content:"pirate"; nocase; fast_pattern; classtype:policy-violation; sid:5111102; rev:1;)

# Generic ".torrent" file download
drop http any any -> any any (msg:"FileShare - Torrent File Download"; flow:established,to_client; file_data; content:".torrent"; nocase; classtype:policy-violation; sid:5111103; rev:2;)

# Magnet link detection (torrent magnet links)
drop http any any -> any any (msg:"FileShare - Magnet Link Detected"; flow:established; content:"magnet:?xt=urn:btih:"; nocase; classtype:policy-violation; sid:5111104; rev:1;)

# ============================================================================
# P2P PROTOCOLS
# ============================================================================

# BitTorrent DHT (Distributed Hash Table)
drop udp any any -> any 6881:6889 (msg:"Torrent - BitTorrent DHT Traffic"; classtype:policy-violation; sid:5111105; rev:1;)

# BitTorrent tracker communication
drop tcp any any -> any 6969 (msg:"Torrent - BitTorrent Tracker Communication"; classtype:policy-violation; sid:5111106; rev:1;)

# eMule/eDonkey protocol
drop tcp any any -> any 4661:4665 (msg:"P2P - eMule/eDonkey Traffic"; classtype:policy-violation; sid:5111107; rev:1;)

