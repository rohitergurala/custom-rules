# File Sharing & Torrent Detection Rules for Suricata
# Purpose: Detect and block DNS queries AND HTTP/HTTPS access to torrent and file sharing sites
# Created: December 2024

# ============================================================================
# MAJOR TORRENT SITES
# ============================================================================

# THE PIRATE BAY - DNS + HTTP DETECTION
drop dns any any -> any any (msg:"Torrent - The Pirate Bay DNS Query"; dns_query; content:"thepiratebay"; nocase; classtype:policy-violation; sid:5111000; rev:1;)
drop tls any any -> any any (msg:"Torrent - The Pirate Bay TLS SNI"; flow:established,to_server; tls.sni; content:"thepiratebay"; nocase; fast_pattern; classtype:policy-violation; sid:5111001; rev:1;)
drop http any any -> any any (msg:"Torrent - The Pirate Bay HTTP Access"; flow:established,to_server; http.host; content:"thepiratebay"; classtype:policy-violation; sid:5111002; rev:1;)

