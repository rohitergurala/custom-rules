:x# Social Media Detection Rules for Suricata
# Purpose: Detect and block DNS queries AND HTTP access to major social media platforms
# Created: December 2024
# This file combines custom soi
icial media rules and Emerging Threats instant messaging rules
# Total Rules: 345

drop dns any any -> any any (msg:"Social Media - Facebook DNS Query"; dns_query; content:"facebook.com"; classtype:policy-violation; sid:5117000; rev:1;)
drop tls any any -> any any (msg:"Social Media - Facebook TLS SNI"; flow:established,to_server; tls.sni; content:"facebook.com"; fast_pattern; classtype:policy-violation; sid:5117001; rev:1;)
